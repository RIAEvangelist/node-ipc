<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AssemblyName>NodeIpc</AssemblyName>
    <RootNamespace>NodeIpc</RootNamespace>
    <PackageId>node-ipc</PackageId>
    <Version>14.0.0</Version>
    <Authors>Brandon Nozaki Miller</Authors>
    <Description>Dependency-free C# IPC compatible with node-ipc, with a JavaScript-shaped client and server API.</Description>
    <PackageTags>ipc;socket;node-ipc;interprocess;tcp;udp;named-pipe;unix-socket</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>licence</PackageLicenseFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/RIAEvangelist/node-ipc</RepositoryUrl>
    <PackageProjectUrl>https://riaevangelist.github.io/node-ipc/</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="../../../../licence" Pack="true" PackagePath="/" Link="licence" />
  </ItemGroup>
</Project>
