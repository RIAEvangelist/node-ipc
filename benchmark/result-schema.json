{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riaevangelist.github.io/node-ipc/data/benchmarks/result-schema.json",
  "title": "node-ipc sanitized tracked benchmark result",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "generatedAt",
    "record",
    "repository",
    "system",
    "oracle",
    "evidence",
    "config",
    "samples",
    "summary",
    "memory",
    "gc",
    "cleanup",
    "packageFootprint"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "pattern": "^run-[A-Za-z0-9-]+$"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "record": {
      "type": "object",
      "required": ["file", "recordedAt"],
      "properties": {
        "file": {"type": "string", "pattern": "^run-[A-Za-z0-9-]+[.]json$"},
        "recordedAt": {"type": "string", "format": "date-time"}
      }
    },
    "repository": {
      "type": "object",
      "required": ["capture", "changedDuringRun", "commit", "dirty", "preExecution", "postExecution"],
      "properties": {
        "capture": {"const": "pre-and-post-execution"},
        "changedDuringRun": {"const": false},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"const": false},
        "preExecution": {"type": "object", "required": ["capturedAt", "commit", "dirty", "statusSha256"]},
        "postExecution": {"type": "object", "required": ["capturedAt", "commit", "dirty", "statusSha256"]}
      }
    },
    "system": {
      "type": "object",
      "required": ["architecture", "cpu", "environment", "machine", "node", "platform", "release", "totalMemoryBytes"],
      "properties": {
        "architecture": {"type": "string", "minLength": 1},
        "cpu": {"type": "object", "required": ["count", "model"]},
        "environment": {
          "type": "object",
          "required": ["githubRepository", "imageOS", "imageVersion", "nodeLane", "npm", "osLane", "provider", "runAttempt", "runId", "runnerArchitecture", "runnerEnvironment", "sourceRef", "sourceSha", "workflow", "workflowRef", "workflowSha"],
          "properties": {
            "githubRepository": {"type": ["string", "null"]},
            "imageOS": {"type": ["string", "null"]},
            "imageVersion": {"type": ["string", "null"]},
            "nodeLane": {"type": ["string", "null"]},
            "npm": {"type": ["string", "null"]},
            "osLane": {"type": ["string", "null"]},
            "provider": {"enum": ["github-actions", "local"]},
            "runAttempt": {"type": ["string", "null"]},
            "runId": {"type": ["string", "null"]},
            "runnerArchitecture": {"type": ["string", "null"]},
            "runnerEnvironment": {"type": ["string", "null"]},
            "sourceRef": {"type": ["string", "null"]},
            "sourceSha": {"type": ["string", "null"]},
            "workflow": {"type": ["string", "null"]},
            "workflowRef": {"type": ["string", "null"]},
            "workflowSha": {"type": ["string", "null"]}
          }
        },
        "machine": {"type": "object", "required": ["id"]},
        "node": {"type": "string", "pattern": "^v[0-9]+[.]"},
        "platform": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1},
        "totalMemoryBytes": {"type": "integer", "minimum": 1}
      }
    },
    "oracle": {
      "type": "object",
      "required": ["build", "implementation", "source"],
      "properties": {
        "implementation": {"const": "standard-c"},
        "source": {"type": "object", "required": ["sha256"]},
        "build": {
          "type": "object",
          "required": ["binarySha256", "compiler", "flags", "sourceSha256", "target", "version"],
          "properties": {
            "binarySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "compiler": {"type": "string", "minLength": 1},
            "flags": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
            "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "target": {"type": "object", "required": ["architecture", "name", "platform"]},
            "version": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["authority", "classification", "comparison", "packageFootprintStatus", "privacy", "publishable", "rankingEligible", "reasons"],
      "properties": {
        "authority": {"const": "snapshot-noisy"},
        "classification": {"const": "clean-c-oracle-snapshot"},
        "comparison": {"type": "object", "required": ["adapters", "state"]},
        "packageFootprintStatus": {"const": "measured"},
        "privacy": {"type": "object", "required": ["excluded", "sanitized"]},
        "publishable": {"const": true},
        "rankingEligible": {"const": false},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "config": {
      "type": "object",
      "required": ["adapters", "footprint", "frames", "host", "oracle", "passes", "payloadBytes", "quick", "samplesPerPass", "timeoutMs", "warmupFrames"],
      "properties": {
        "adapters": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "footprint": {"const": true},
        "frames": {
          "type": "object",
          "required": ["latency", "resource", "speed"],
          "properties": {
            "latency": {"const": 1000000},
            "resource": {"const": 1000000},
            "speed": {"const": 1000000}
          }
        },
        "host": {"const": "127.0.0.1"},
        "oracle": {"const": "c"},
        "passes": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["speed", "resource", "latency"]}},
        "payloadBytes": {"const": 64},
        "quick": {"const": false},
        "samplesPerPass": {"const": 7},
        "timeoutMs": {"const": 600000},
        "warmupFrames": {"const": 100000}
      }
    },
    "samples": {
      "type": "array",
      "minItems": 21,
      "items": {
        "type": "object",
        "required": ["adapter", "cleanup", "exact", "gc", "index", "latencyNs", "memory", "metrics", "package", "pass", "processExit"]
      }
    },
    "summary": {
      "type": "object",
      "required": ["metric", "platform", "groups"],
      "properties": {
        "metric": {"const": "milliseconds-per-million"},
        "platform": {"type": "string", "minLength": 1},
        "groups": {"type": "array", "minItems": 3}
      }
    },
    "memory": {"type": "object"},
    "gc": {"type": "object"},
    "cleanup": {
      "type": "object",
      "required": ["clean", "endpointLeaks", "endpointReuseFailures", "leftoverBytes", "leftoverEntries", "openSockets", "samples"],
      "properties": {
        "clean": {"const": true},
        "endpointLeaks": {"const": 0},
        "endpointReuseFailures": {"const": 0},
        "leftoverBytes": {"const": 0},
        "leftoverEntries": {"const": 0},
        "openSockets": {"const": 0},
        "samples": {"type": "integer", "minimum": 21}
      }
    },
    "packageFootprint": {
      "type": "object",
      "required": ["dependencies", "installed", "package", "tarball"]
    }
  },
  "not": {
    "anyOf": [
      {"required": ["pids"]},
      {"required": ["endpoints"]}
    ]
  },
  "additionalProperties": false
}
